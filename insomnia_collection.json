      - url: "{{ _.base_url }}/places/{% prompt 'AccessTripDB', 'Entre com o ID do
          Estabelecimento', '10', '', false, true %}/reviews"
        name: 4.2 Criar Avaliação (Exclusivo TRAVELER)
        meta:
          id: req_aea07d7629aa4bf4933172ba8e271ea4
          created: 1724926500000
          modified: 1788002030538
          isPrivate: false
          description: Publica uma avaliação. Apenas usuários do tipo TRAVELER têm
            permissão.
          sortKey: 502
        method: POST
        body:
          mimeType: application/json
          text: |-
            {
              "experience_rating": {{ randomAvaliacao }},
              "accessibility_level": "{{ randomNivelAcessibilidade }}",
              "comment_text": "{% faker 'randomJobDescriptor' %}"
            }
        headers:
          - name: Content-Type
            value: application/json
          - name: Authorization
            value: Bearer {% response 'body', 'req_e3c283974ad8461082c274cc55dc08c5',
              'b64::JC50b2tlbg==::46b', 'never', 60 %}
        scripts:
          preRequest: >-
            const bit = Math.round(Math.random());

            const randInt = (min, max) => Math.floor(Math.random() * (max - min
            + 1)) + min;

            const randDec = (min, max, casas = 2) =>
              (Math.random() * (max - min) + min).toFixed(casas);

            // sorteia um item de qualquer array

            const randItem = (lista) => lista[Math.floor(Math.random() *
            lista.length)];


            const CATEGORIAS = [
              'ACCOMMODATION',
              'GASTRONOMY',
              'TOURIST_ATTRACTION',
              'OTHERS'
            ];


            const STATES = [
              'sp',
              'RJ',
              'PR',
              'SC',
            	'MG',
            	'MT',
            	'MS'
            ];



            const ACCESSIBILITY_LEVEL = [
              'POOR',
              'GOOD',
              'EXCELLENT'
            ];


            insomnia.environment.set('randomBit', bit);

            insomnia.environment.set('randomPreco', randDec(100, 500, 2));

            insomnia.environment.set('randomAvaliacao', randInt(1, 5));

            insomnia.environment.set('randomCategoria', randItem(CATEGORIAS));

            insomnia.environment.set('randomCidade', randItem(STATES));

            insomnia.environment.set('randomNivelAcessibilidade',
            randItem(ACCESSIBILITY_LEVEL));
        settings:
          renderRequestBody: true
          encodeUrl: true
          followRedirects: global
          cookies:
            send: true
            store: true
          rebuildPath: true
      - url: "{{ _.base_url }}/reviews/{% prompt 'AccessTripDB', 'Entre com o ID do
          Comentário', '3', '', false, true %}/reply"
        name: 4.5 Responder Avaliação (Exclusivo BUSINESS)
