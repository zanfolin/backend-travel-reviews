          - name: Authorization
            value: Bearer {% response 'body', 'req_eb20f0bc69f14e7aadad25fb6c690c47',
              'b64::JC50b2tlbg==::46b', 'never', 60 %}
        settings:
          renderRequestBody: true
          encodeUrl: true
          followRedirects: global
          cookies:
            send: true
            store: true
          rebuildPath: true
