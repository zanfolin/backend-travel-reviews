# Server Configuration
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Database Configuration
DATABASE_CLIENT=sqlite3
DATABASE_FILE=./database/accesstrip.sqlite

# JWT Secret & Expiration
JWT_SECRET=super_secret_jwt_key_accesstrip_2026_change_in_production
JWT_EXPIRES_IN=7d

# Email / SMTP Configuration (Nodemailer)
# For local development, if SMTP credentials are not provided or set to test, an Ethereal test account is created automatically.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AccessTrip <no-reply@accesstrip.com>"

# Upload Configuration
MAX_FILE_SIZE_MB=5
